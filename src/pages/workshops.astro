---
import Layout from '../layouts/Layout.astro';
import { WORKSHOPS } from '../data/workshops';

const COMING_SOON = false; // set to true to show coming soon placeholder

const workshops = WORKSHOPS;
---

<Layout title="Workshops - AF Comedy Fest">
  <div class="workshops-wrapper">
    <div class="max-width">
      <h1>Workshops</h1>

{COMING_SOON ? (
        <div class="coming-soon-box">Workshops info coming soon!</div>
      ) : (
        <>
          <div class="workshops-grid">
            {workshops.map((workshop) => (
              <div class="workshop-card">
                <div class="workshop-image">
                  {workshop.image
                    ? <img src={workshop.image.src} alt={workshop.teacher} />
                    : <div class="image-placeholder">{workshop.teacher[0]}</div>
                  }
                </div>
                <div class="workshop-body">
                  <h3 class="workshop-title">{workshop.title}</h3>
                  <p class="teacher-name">with {workshop.teacher}</p>
                  <div class="workshop-details">
                    <div class="detail"><span class="label">Date</span><span>{workshop.date}</span></div>
                    <div class="detail"><span class="label">Time</span><span>{workshop.startTime} – {workshop.endTime}</span></div>
                    <div class="detail"><span class="label">Location</span><span>{workshop.location}</span></div>
                    <div class="detail"><span class="label">Cost</span><span>${workshop.cost}</span></div>
                    {workshop.capacity && (
                      <div class="detail"><span class="label">Capacity</span><span>{workshop.capacity} spots</span></div>
                    )}
                  </div>
                  <div class="card-actions">
                    {workshop.bio && (
                      <button class="more-info-btn" data-slug={workshop.slug}>More Info</button>
                    )}
                    {workshop.link
                      ? <a class="register-btn" href={workshop.link} target="_blank" rel="noopener noreferrer" data-workshop={workshop.slug}>Register</a>
                      : <span class="register-btn-disabled" data-workshop={workshop.slug}>Registration Coming Soon</span>
                    }
                  </div>
                </div>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  </div>

  <!-- Modals -->
  {workshops.map((workshop) => workshop.bio && (
    <div class="modal-overlay" id={`modal-${workshop.slug}`}>
      <div class="modal">
        <button class="modal-close" data-slug={workshop.slug}>✕</button>
        <div class="modal-header">
          {workshop.image && <img src={workshop.image.src} alt={workshop.teacher} class="modal-image" />}
          <h2 class="modal-title">{workshop.title}</h2>
          <p class="modal-teacher">with {workshop.teacher}</p>
        </div>
        <div class="modal-bio" set:html={workshop.bio} />
        <div class="modal-details">
          <div class="detail"><span class="label">Date</span><span>{workshop.date}</span></div>
          <div class="detail"><span class="label">Time</span><span>{workshop.startTime} – {workshop.endTime}</span></div>
          <div class="detail"><span class="label">Location</span><span>{workshop.location}</span></div>
          <div class="detail"><span class="label">Cost</span><span>${workshop.cost}</span></div>
          {workshop.capacity && (
            <div class="detail"><span class="label">Capacity</span><span>{workshop.capacity} spots</span></div>
          )}
        </div>
        <div class="modal-actions">
          {workshop.link
            ? <a class="register-btn" href={workshop.link} target="_blank" rel="noopener noreferrer" data-workshop={workshop.slug}>Register</a>
            : <span class="register-btn-disabled" data-workshop={workshop.slug}>Registration Coming Soon</span>
          }
        </div>
      </div>
    </div>
  ))}

  <style>
    .workshops-wrapper {
      background: #1a1a1a;
      padding: 2rem;
      min-height: 100vh;
    }

    .max-width {
      max-width: 1400px;
      margin: 0 auto;
    }

    h1 {
      color: #D4A574;
      font-size: 2.5rem;
      margin-bottom: 0.5rem;
      margin-top: 0;
    }

    .workshops-wrapper > .max-width > p {
      color: #E8DCC8;
      font-size: 1.1rem;
      margin-bottom: 1.5rem;
    }

    .links-disclaimer {
      background: #2a2a2a;
      border: 1px solid #D4A574;
      border-radius: 6px;
      padding: 0.75rem 1.25rem;
      color: #E8DCC8;
      font-size: 0.95rem;
      margin-bottom: 2rem;
    }

    .coming-soon-box {
      border: 2px solid #D4A574;
      border-radius: 8px;
      padding: 3rem 2rem;
      text-align: center;
      color: #D4A574;
      font-size: 1.5rem;
      font-weight: 600;
      background: #2a2a2a;
    }

    /* Grid */
    .workshops-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 2rem;
    }

    /* Card */
    .workshop-card {
      background: #2a2a2a;
      border-radius: 10px;
      overflow: hidden;
      border: 2px solid #333;
      display: flex;
      flex-direction: column;
      transition: border-color 0.3s, box-shadow 0.3s;
    }

    .workshop-card:hover {
      border-color: #D4A574;
      box-shadow: 0 6px 24px rgba(212, 165, 116, 0.2);
    }

    .workshop-image {
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      background: #333;
    }

    .workshop-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      display: block;
    }

    .image-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 5rem;
      font-weight: 700;
      color: #D4A574;
    }

    .workshop-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .workshop-title {
      color: #D4A574;
      font-size: 1.2rem;
      font-weight: 700;
      margin: 0 0 0.25rem;
    }

    .teacher-name {
      color: #E8DCC8;
      font-size: 0.95rem;
      margin: 0 0 1rem;
    }

    .workshop-details {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin-bottom: 1.25rem;
    }

    .detail {
      display: flex;
      justify-content: space-between;
      font-size: 0.88rem;
      color: #E8DCC8;
      gap: 0.5rem;
    }

    .label {
      color: #D4A574;
      font-weight: 600;
      flex-shrink: 0;
    }

    /* Buttons */
    .card-actions {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin-top: auto;
    }

    .more-info-btn {
      background: #D4A574;
      color: #000;
      border: none;
      border-radius: 5px;
      padding: 0.65rem 1rem;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.2s;
    }

    .more-info-btn:hover {
      background: #c49060;
    }

    .register-btn {
      display: block;
      text-align: center;
      padding: 0.65rem 1rem;
      border-radius: 5px;
      font-size: 0.9rem;
      font-weight: 600;
      background: #D4A574;
      color: #000;
      border: none;
      text-decoration: none;
      transition: background 0.2s;
    }

    .register-btn:hover {
      background: #c49060;
    }

    .register-btn-disabled {
      display: block;
      text-align: center;
      padding: 0.65rem 1rem;
      border-radius: 5px;
      font-size: 0.9rem;
      font-weight: 600;
      background: #3a3a3a;
      color: #666;
      border: 1px solid #444;
      cursor: not-allowed;
    }

    /* Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .modal-overlay.open {
      display: flex;
    }

    .modal {
      background: #2a2a2a;
      border: 2px solid #D4A574;
      border-radius: 10px;
      max-width: 640px;
      width: 100%;
      max-height: 85vh;
      overflow-y: auto;
      padding: 2rem;
      position: relative;
    }

    .modal-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      background: none;
      border: none;
      color: #D4A574;
      font-size: 1.25rem;
      cursor: pointer;
      line-height: 1;
      padding: 0.25rem 0.5rem;
    }

    .modal-close:hover {
      color: #fff;
    }

    .modal-header {
      display: flex;
      flex-direction: column;
      margin-bottom: 1.25rem;
    }

    .modal-image {
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: 10px;
      object-fit: cover;
      object-position: top;
      border: 2px solid #D4A574;
      display: block;
      margin-bottom: 1rem;
    }

    .modal-title {
      color: #D4A574;
      font-size: 1.4rem;
      margin: 0 0 0.25rem;
    }

    .modal-teacher {
      color: #E8DCC8;
      margin: 0;
      font-size: 0.95rem;
    }

    .modal-details {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      margin-top: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid #444;
    }

    .modal-bio {
      color: #E8DCC8;
      line-height: 1.7;
      font-size: 0.95rem;
    }

    .modal-actions {
      margin-top: 1.5rem;
      padding-top: 1.25rem;
      border-top: 1px solid #444;
    }

    .modal-actions .register-btn-disabled {
      display: block;
      text-align: center;
    }

    .modal-bio h4 {
      color: #D4A574;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin: 1rem 0 0.4rem;
    }

    .modal-bio h4:first-child {
      margin-top: 0;
    }

    .modal-bio p {
      margin: 0 0 0.75rem;
    }

    .modal-bio a {
      color: #D4A574;
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .modal-bio p:last-child {
      margin-bottom: 0;
    }

    /* Responsive */
    @media (max-width: 768px) {
      h1 { font-size: 1.8rem; }

      .workshops-grid {
        grid-template-columns: 1fr;
      }

    }
  </style>

  <script>
    document.querySelectorAll('.more-info-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-slug');
        document.getElementById(`modal-${slug}`)?.classList.add('open');
        document.body.style.overflow = 'hidden';
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'workshop_more_info', {
            event_category: 'workshops',
            event_label: slug,
          });
        }
      });
    });

    document.querySelectorAll('.modal-close').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-slug');
        document.getElementById(`modal-${slug}`)?.classList.remove('open');
        document.body.style.overflow = '';
      });
    });

    document.querySelectorAll('.modal-overlay').forEach(overlay => {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) {
          overlay.classList.remove('open');
          document.body.style.overflow = '';
        }
      });
    });

    document.querySelectorAll('.register-btn, .register-btn-disabled').forEach(btn => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-workshop');
        if (typeof window.gtag === 'function') {
          window.gtag('event', 'workshop_link_click', {
            event_category: 'workshops',
            event_label: slug,
          });
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.modal-overlay.open').forEach(overlay => {
          overlay.classList.remove('open');
          document.body.style.overflow = '';
        });
      }
    });
  </script>
</Layout>
