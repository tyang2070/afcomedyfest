---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoImg from '../../assets/af_logo.png';
import pickThreeImg from '../../assets/ticket_discounts/pick_three.jpg';
import pickFiveImg from '../../assets/ticket_discounts/pick_five.jpg';
import pickTenImg from '../../assets/ticket_discounts/pick_ten.jpg';
import { PERFORMERS } from '../data/performers';

const eventDates = 'September 3-6, 2026';

const featuredActs = PERFORMERS
  .filter(p => p.featured)
  .sort((a, b) => (a.feature_ordering ?? 999) - (b.feature_ordering ?? 999));

const allPerformers = PERFORMERS.sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="AF Comedy Fest - Home">
  <div class="homepage">
    <!-- Hero Section with Logo -->
    <section class="hero-section">
      <div class="hero-content">
        <div class="logo-container">
          <img src={logoImg.src} alt="AF Comedy Fest Logo" class="festival-logo-img" />
        </div>
      </div>
    </section>

    <!-- Dates and Location Banner -->
    <section class="dates-location-banner">
      <div class="festival-presenter">Asian AF & Outside In Theatre Present:</div>
      <div class="festival-title">AF Comedy Festival</div>
      <div class="dates-location-content">
        <span class="dates">{eventDates}</span>
        <span class="separator">/</span>
        <a href="https://outsideintheatre.org/" target="_blank" rel="noopener noreferrer" class="location">
          Los Angeles, CA (Outside In Theatre)
        </a>
      </div>
      <a href="https://maps.app.goo.gl/ULx67eF1pRFUaQLw6" target="_blank" rel="noopener noreferrer" class="venue-address">
        📍 5317 York Blvd, Los Angeles, CA 90042
      </a>
    </section>

    <!-- Featured Acts Section -->
    <section class="featured-acts-section">
      <div class="section-label">FEATURING</div>
      <div class="featured-grid">
        {featuredActs.map((act) => (
          <a href={`/performers/${act.slug}`} class="featured-card-link">
            <div class="featured-card">
              <div class="featured-image">
                {act.image
                  ? <Image src={act.image} alt={act.name} width={200} height={200} />
                  : <div class="featured-image-placeholder">{act.name[0]}</div>
                }
              </div>
              <h3 class="featured-name">{act.name}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- All Performers Section -->
    <section class="performers-section">
      <div class="section-label performers-label">PERFORMERS</div>
      <div class="performers-content">
        <div class="performers-list">
          {allPerformers.map((performer, idx) => (
            <>
              {idx > 0 && <span class="separator-text"> / </span>}
              <a href={`/performers/${performer.slug}`} class="performer-name">{performer.name}</a>
            </>
          ))}
        </div>
      </div>
    </section>

    <!-- Tickets Section -->
    <section class="tickets-section">
      <div class="section-label">GET TICKETS</div>
      <div class="tickets-content">
        <div class="ticket-links">
          <a href="https://outsideintheatre.org/af-comedy-fest/shows/" target="_blank" rel="noopener noreferrer" class="ticket-btn ticket-btn-primary">Buy Individual Tickets</a>
        </div>
        <p class="bundle-label">Buy Discounted Ticket Bundles</p>
        <div class="bundle-tiers">
          <a href="https://outsideintheatre.vbotickets.com/subscriptions/8868?filter=s%7C22441" target="_blank" rel="noopener noreferrer" class="tier-img-link">
            <Image src={pickThreeImg} alt="Pick 3 shows – 10% off" class="tier-img" />
          </a>
          <a href="https://outsideintheatre.vbotickets.com/subscriptions/8868?filter=s%7C22467" target="_blank" rel="noopener noreferrer" class="tier-img-link">
            <Image src={pickFiveImg} alt="Pick 5 shows – 15% off" class="tier-img" />
          </a>
          <a href="https://outsideintheatre.vbotickets.com/subscriptions/8868?filter=s%7C22471" target="_blank" rel="noopener noreferrer" class="tier-img-link">
            <Image src={pickTenImg} alt="Pick 10 shows – 25% off" class="tier-img" />
          </a>
        </div>
      </div>
    </section>

    <!-- Donations Section -->
    <section class="donations-section">
      <div class="section-label">DONATE</div>
      <div class="donations-content">
        <p class="donation-text">
          The AF Comedy Festival is a sponsored project of Fractured Atlas, a non-profit arts service organization.
          Contributions for the charitable purposes of AF Comedy Festival must be made payable to
          <strong>"Fractured Atlas"</strong> only and are tax-deductible to the extent permitted by law.
        </p>
        <a href="https://fundraising.fracturedatlas.org/af-comedy-festival/general_support" target="_blank" rel="noopener noreferrer" class="donate-btn">Donate to AF Comedy Fest</a>
      </div>
    </section>

  </div>

  <style>
    .homepage {
      width: 100%;
      background: #1a1a1a;
    }

    /* Hero Section */
    .hero-section {
      background: #000000;
      padding: 0.5rem 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 400px;
      position: relative;
      border: none;
      border-radius: 0;
      margin: 0;
      border-bottom: 2px solid #D4A574;
    }

    .hero-content {
      text-align: center;
      width: 100%;
    }

    .logo-container {
      background: #000000;
      border: none;
      border-radius: 0;
      padding: 1rem;
      max-width: 800px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .festival-logo-img {
      max-width: 100%;
      height: auto;
      max-height: 500px;
    }

    /* Dates and Location Banner */
    .dates-location-banner {
      background: #000000;
      padding: 2rem;
      text-align: center;
      color: #D4A574;
      border-top: 2px solid #D4A574;
      border-bottom: 2px solid #D4A574;
    }

    .festival-presenter {
      font-size: 1.9rem;
      font-weight: 700;
      color: #D4A574;
      text-align: center;
      margin-bottom: 0.5rem;
      font-family: 'Miranda Sans', sans-serif;
      letter-spacing: 0.05em;
    }

    .festival-title {
      font-size: 3.5rem;
      font-weight: 700;
      color: #D4A574;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      text-align: center;
      margin-bottom: 1.5rem;
      font-family: 'Miranda Sans', sans-serif;
    }

    .dates-location-content {
      font-size: 2.2rem;
      font-weight: 700;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
      font-family: 'Miranda Sans', sans-serif;
    }

    .separator {
      color: #D4A574;
      font-size: 2rem;
    }

    .location {
      color: #D4A574;
      text-decoration: none;
      transition: opacity 0.3s;
      border-bottom: 2px solid transparent;
      transition: border-bottom 0.3s;
    }

    .location:hover {
      opacity: 0.8;
      border-bottom-color: #D4A574;
    }

    .venue-address {
      display: block;
      text-align: center;
      margin-top: 0.75rem;
      font-size: 1rem;
      color: #E8DCC8;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: opacity 0.3s;
    }

    .venue-address:hover {
      opacity: 0.7;
    }

    /* Featured Acts Section */
    .featured-acts-section {
      background: #1a1a1a;
      padding: 4rem 4rem;
      color: white;
      width: 100%;
      border-top: 2px solid #D4A574;
      border-bottom: 2px solid #D4A574;
    }

    .section-label {
      font-size: 2.5rem;
      font-weight: 900;
      color: #D4A574;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 3rem;
      font-family: 'Miranda Sans', sans-serif;
    }

    .featured-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 2rem;
    }

    .featured-card-link {
      text-decoration: none;
      color: inherit;
      display: block;
    }

    .featured-card {
      text-align: center;
      transition: transform 0.3s;
    }

    .featured-card-link:hover .featured-card {
      transform: translateY(-4px);
    }

    .featured-image {
      width: 200px;
      height: 200px;
      border-radius: 20px;
      overflow: hidden;
      margin: 0 auto 1rem;
      background: #555;
    }

    .featured-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .featured-image-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3rem;
      font-weight: 700;
      color: #D4A574;
      background: #2a2a2a;
    }

    .featured-name {
      font-size: 1.4rem;
      font-weight: 700;
      color: #D4A574;
      margin: 0.5rem 0;
      font-family: 'Miranda Sans', sans-serif;
    }

    .featured-type {
      font-size: 0.9rem;
      color: #E8DCC8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin: 0.25rem 0;
    }

    .featured-location {
      font-size: 0.85rem;
      color: #E8DCC8;
      margin: 0;
    }

    /* All Performers Section */
    .performers-section {
      background: #1a1a1a;
      padding: 4rem 4rem;
      border-top: 2px solid #D4A574;
      border-bottom: 2px solid #D4A574;
      width: 100%;
    }

    .performers-content {
      width: 100%;
    }

    .performers-list {
      text-align: center;
      font-size: 1rem;
      line-height: 1.8;
      color: #D4A574;
      font-weight: 500;
      font-family: 'Miranda Sans', sans-serif;
      word-spacing: 0.1em;
    }

    .performer-name {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid #D4A574;
      display: inline;
      padding-bottom: 1px;
    }

    .performer-name:hover {
      opacity: 0.7;
    }

    .separator-text {
      color: #D4A574;
      margin: 0 0.25rem;
    }


    /* Tickets Section */
    .tickets-section {
      background: #000;
      padding: 4rem 4rem;
      border-top: 2px solid #D4A574;
      border-bottom: 2px solid #D4A574;
      text-align: center;
    }

    .ticket-links {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }

    .ticket-btn {
      display: inline-block;
      padding: 0.9rem 2rem;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: 700;
      text-decoration: none;
      font-family: 'Miranda Sans', sans-serif;
      letter-spacing: 0.05em;
      transition: opacity 0.2s, transform 0.2s;
    }

    .ticket-btn:hover {
      opacity: 0.85;
      transform: translateY(-2px);
    }

    .ticket-btn-primary {
      background: #D4A574;
      color: #000;
    }

    .ticket-btn-secondary {
      background: transparent;
      color: #D4A574;
      border: 2px solid #D4A574;
    }

    .bundle-note {
      color: #E8DCC8;
      font-size: 0.95rem;
      margin: 0 0 1.5rem;
    }

    .bundle-note strong {
      color: #D4A574;
    }

    .bundle-label {
      color: #D4A574;
      font-size: 1.1rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin: 0 0 1rem;
      font-family: 'Miranda Sans', sans-serif;
    }

    .bundle-tiers {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .tier-img-link {
      display: block;
      border-radius: 8px;
      overflow: hidden;
      transition: transform 0.2s, box-shadow 0.2s;
      flex: 1;
      max-width: 220px;
    }

    .tier-img-link:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(212, 165, 116, 0.3);
    }

    .tier-img {
      width: 100%;
      height: auto;
      display: block;
    }

    /* Donations Section */
    .donations-section {
      background: #1a1a1a;
      padding: 4rem 4rem;
      border-top: 2px solid #D4A574;
      text-align: center;
    }

    .donations-content {
      max-width: 680px;
      margin: 0 auto;
    }

    .donation-text {
      color: #E8DCC8;
      font-size: 1rem;
      line-height: 1.7;
      margin: 0 0 2rem;
    }

    .donation-text strong {
      color: #D4A574;
    }

    .donate-btn {
      display: inline-block;
      padding: 0.9rem 2.5rem;
      background: #D4A574;
      color: #000;
      border-radius: 6px;
      font-size: 1rem;
      font-weight: 700;
      text-decoration: none;
      font-family: 'Miranda Sans', sans-serif;
      letter-spacing: 0.05em;
      transition: opacity 0.2s, transform 0.2s;
    }

    .donate-btn:hover {
      opacity: 0.85;
      transform: translateY(-2px);
    }

    @media (max-width: 1024px) {
      .featured-acts-section {
        padding: 3rem 2rem;
      }

      .featured-grid {
        grid-template-columns: repeat(4, 1fr);
      }

      .performers-section {
        padding: 3rem 2rem;
      }
    }

    @media (max-width: 768px) {
      .tickets-section,
      .donations-section {
        padding: 3rem 2rem;
      }

      .bundle-tiers {
        gap: 1rem;
      }

      .hero-section {
        min-height: 300px;
        margin: 0;
        border-width: 0;
      }

      .festival-logo {
        font-size: 2.5rem;
      }

      .dates-location-content {
        font-size: 1.5rem;
        gap: 0.75rem;
      }

      .featured-acts-section {
        padding: 2rem 1.5rem;
      }

      .featured-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
      }

      .featured-image {
        width: 150px;
        height: 150px;
      }

      .featured-name {
        font-size: 1.1rem;
      }

      .performers-section {
        padding: 2rem 1.5rem;
      }

      .performers-list {
        font-size: 0.9rem;
      }
    }

    @media (max-width: 480px) {
      .hero-section {
        min-height: 250px;
        margin: 0;
        border-width: 0;
        padding: 2rem 1rem;
      }

      .festival-logo {
        font-size: 2rem;
      }

      .dates-location-content {
        font-size: 1.2rem;
        gap: 0.5rem;
      }

      .featured-acts-section {
        padding: 1.5rem 1rem;
      }

      .featured-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      .featured-image {
        width: 100px;
        height: 100px;
      }

      .section-label {
        font-size: 0.9rem;
        margin-bottom: 2rem;
      }

      .performers-section {
        padding: 1.5rem 1rem;
      }

      .performers-list {
        font-size: 0.8rem;
        line-height: 1.6;
      }
    }
  </style>
</Layout>
